# ====================================================
# MySQL Connection Settings:
#   - MYSQL_HOST: Host address where MySQL server is reachable.
#                 Use "127.0.0.1" for local Docker host access.
# ====================================================
MYSQL_HOST="127.0.0.1"


# ====================================================
# Port Configuration:
#   - MYSQL_INTERNAL_PORT: Internal port used within Docker network 
#                          for container-to-container communication
#   - MYSQL_EXTERNAL_PORT: External port exposed to host machine for 
#                          direct MySQL access from outside Docker
# ====================================================
MYSQL_INTERNAL_PORT=3306
MYSQL_EXTERNAL_PORT=3306


# ====================================================
# Docker Container Names:
#   - MYSQL_SERVER_CONTAINER: MySQL server container name for 
#                             actual database instance
#   - MYSQL_CLIENT_CONTAINER: MySQL client container name for 
#                             database administration, testing, and CLI access
# ====================================================
MYSQL_SERVER_CONTAINER=mysql-server
MYSQL_CLIENT_CONTAINER=mysql-client


# ====================================================
# MySQL Root Configuration
# ====================================================
MYSQL_ROOT_PASSWORD=password


# ====================================================
# MySQL Application Credentials
# ====================================================
MYSQL_USERNAME=not_superuser
MYSQL_PASSWORD=password


# ====================================================
# !!!!!!!!!!!!!!!!!!!Security Note!!!!!!!!!!!!!!!!!!!!
# ====================================================
# The root account has full server access,
# which is why it should be used exclusively for administrative tasks.
#
# The MYSQL_USER_NAME should be used for application connections
# to follow to the principle of least privilege.
# ====================================================
# !!!!!!!!!!!!!!!!!!!Security Note!!!!!!!!!!!!!!!!!!!!
# ====================================================


# ====================================================
# MySQL Database Configuration:
#   - Default database assigned to the application user.
# ====================================================
MYSQL_DB_NAME=not_superuser_db


# ====================================================  
# MySQL Persistent Data Storage Path:  
#   - Local filesystem path where MySQL database files, logs, and configuration
#     data will be persisted across container restarts and recreations.
# ====================================================  
MYSQL_DATA_PATH=/path/to/mysql-data


# ====================================================
# SQL Logging (Echo Mode):
#   - If True, all executed SQL statements are printed to stdout.
#   - Useful for debugging; should be disabled in production.
# ====================================================
MYSQL_ECHO=False


# ====================================================
# Automatic Transaction Commits:
#   - If True, each database operation is automatically committed.
#   - Not recommended for production; explicit commits provide better control.
# ====================================================
MYSQL_AUTOCOMMIT=False


# ====================================================
# Automatic Session Flushing:
#   - If True, pending changes are automatically synchronized to the database before queries.
#   - Disabling (False) gives explicit control via session.flush().
# ====================================================
MYSQL_AUTOFLUSH=False